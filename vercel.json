{
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "public/files/**/*.json"
    }
  },
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "framework": "vite",
  "headers": [
    {
      "source": "/files/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/files/(.*)",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
